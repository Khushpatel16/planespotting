# Heavy Watch LAX backend configuration. Copy to backend/.env and edit as needed.
# All variables are optional; the defaults below run a fully working local instance.

# --- Polling / ingestion ---
HWL_POLL_INTERVAL_SECONDS=7
HWL_SEARCH_RADIUS_NM=250
# Order in which ADS-B sources are tried (first success wins): adsblol,airplaneslive,opensky
HWL_ADSB_SOURCES=adsblol,airplaneslive
# IMPORTANT: put a real email or URL here - planespotters.net photo lookups reject
# User-Agents without a reachable contact.
HWL_USER_AGENT=HeavyWatchLAX/1.0 (you@example.com)

# --- Inbound alert tuning ---
HWL_ALERT_RADIUS_NM=60
HWL_INBOUND_MAX_ALTITUDE_FT=13000
HWL_INBOUND_DESCENT_RATE_FPM=-150

# --- OpenSky (optional last-resort fallback; anonymous is heavily rate-limited) ---
# HWL_OPENSKY_USERNAME=
# HWL_OPENSKY_PASSWORD=

# --- Route lookup (origin/destination via adsb.lol; heavies only, cached) ---
HWL_ROUTE_LOOKUP_ENABLED=true
# HWL_ROUTE_CACHE_TTL_SECONDS=1800
# HWL_ROUTE_MAX_NEW_PER_TICK=50

# --- Aircraft photos (planespotters.net proxy; set a descriptive HWL_USER_AGENT!) ---
# HWL_PHOTO_CACHE_TTL_SECONDS=21600

# --- Storage ---
# Local default is file-backed SQLite. For production set a managed Postgres URL,
# e.g. Neon/Supabase. postgres:// and ?sslmode=require URLs are normalized automatically.
HWL_DATABASE_URL=sqlite+aiosqlite:///./heavywatch.db
HWL_UPLOADS_DIR=./uploads

# --- CORS (comma-separated origins; * for local dev) ---
HWL_CORS_ORIGINS=*
