# Heavy Watch LAX backend configuration. Copy to backend/.env and edit as needed.
# All variables are optional; the defaults below run a fully working local instance.

# --- Polling / ingestion ---
HWL_POLL_INTERVAL_SECONDS=7
HWL_SEARCH_RADIUS_NM=250
# Order in which ADS-B sources are tried (first success wins): adsblol,adsbfi,airplaneslive,opensky
# airplanes.live returns 403 until you've been approved by email (contact@airplanes.live).
HWL_ADSB_SOURCES=adsblol,adsbfi,airplaneslive
# IMPORTANT: put a real email or URL here - planespotters.net photo lookups reject
# User-Agents without a reachable contact.
HWL_USER_AGENT=HeavyWatchLAX/1.0 (you@example.com)

# --- North-America-wide sweep (slow tile sweep, separate from the LAX loop) ---
# 83 overlapping 250 nm tiles fetched one at a time; a full pass takes ~2 min.
HWL_WIDE_ENABLED=true
# Sources tried per tile, in order (same names as HWL_ADSB_SOURCES).
HWL_WIDE_SOURCES=adsbfi,adsblol
# Seconds between tile requests. adsb.fi asks for <= 1 req/s per IP (shared with the LAX poll).
HWL_WIDE_TILE_INTERVAL_SECONDS=1.5
# HWL_WIDE_SWEEP_PAUSE_SECONDS=8
# HWL_WIDE_MAX_AGE_SECONDS=360
# HWL_WIDE_MAX_AIRCRAFT=6000

# --- Live ATC captions (Whisper on the LiveATC stream being played) ---
# First start downloads the model (~1.5 GB for medium.en) into ~/.cache/huggingface.
# Set false to skip captions entirely (audio player still works).
HWL_ATC_TRANSCRIBE_ENABLED=true
# medium.en is the sweet spot for radio; use small.en on weak machines, large-v3-turbo on GPU.
# HWL_ATC_TRANSCRIBE_MODEL=medium.en
# HWL_ATC_TRANSCRIBE_DEVICE=cpu
# HWL_ATC_TRANSCRIBE_COMPUTE=int8
# HWL_ATC_TRANSCRIBE_THREADS=8
# HWL_ATC_TRANSCRIBE_PRELOAD=true
# HWL_ATC_MAX_SESSIONS=6

# --- Inbound alert tuning ---
HWL_ALERT_RADIUS_NM=60
HWL_INBOUND_MAX_ALTITUDE_FT=13000
HWL_INBOUND_DESCENT_RATE_FPM=-150

# --- OpenSky (optional last-resort fallback; anonymous is heavily rate-limited) ---
# HWL_OPENSKY_USERNAME=
# HWL_OPENSKY_PASSWORD=

# --- Route lookup (origin/destination via adsb.lol; heavies only, cached) ---
HWL_ROUTE_LOOKUP_ENABLED=true
# HWL_ROUTE_CACHE_TTL_SECONDS=1800
# HWL_ROUTE_MAX_NEW_PER_TICK=50

# --- Aircraft photos (planespotters.net proxy; set a descriptive HWL_USER_AGENT!) ---
# HWL_PHOTO_CACHE_TTL_SECONDS=21600

# --- Storage ---
# Local default is file-backed SQLite. For production set a managed Postgres URL,
# e.g. Neon/Supabase. postgres:// and ?sslmode=require URLs are normalized automatically.
HWL_DATABASE_URL=sqlite+aiosqlite:///./heavywatch.db
HWL_UPLOADS_DIR=./uploads

# --- CORS (comma-separated origins; * for local dev) ---
HWL_CORS_ORIGINS=*
